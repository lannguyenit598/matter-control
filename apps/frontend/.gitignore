# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# test / storybook output
/playwright-report
/test-results
/storybook-static
*storybook.log

# python (vendored ui-ux-pro-max skill scripts)
__pycache__/

# Worker build output and local runtime secrets
.open-next/
.wrangler/
.dev.vars
.dev.vars.*
!.dev.vars.example

# Firebase App Hosting adapter output (ADR-007); listed so a local adapter build edits nothing tracked
/.apphosting/
