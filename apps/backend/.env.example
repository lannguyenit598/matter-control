# MatterControl product API (`mcapi`). Copy to .env and export the variables, or pass them directly.
# Never commit real values: the OIDC key file stays outside the repository.

# ---- Required ----
# PRODUCT database only. `mcapi migrate` applies the product migrations to it.
MC_DATABASE_URL=
# Private directory for document bytes (created 0700). Local/PoC adapter: not a production object store.
MC_OBJECT_DIR=
# One canonical issuer, pinned. Introspection is authenticated with the API application's key.
MC_OIDC_ISSUER=
MC_OIDC_INTROSPECTION_URL=
MC_OIDC_AUDIENCE=
# Path of the API application's JSON key file (mode 0600, never printed or logged).
MC_OIDC_API_KEY_FILE=

# ---- Optional ----
# When set, the API refuses to start with a key file that belongs to another application.
MC_OIDC_API_CLIENT_ID=
MC_HTTP_ADDR=127.0.0.1:8081
MC_LOG_LEVEL=info
MC_REQUEST_TIMEOUT=10s
MC_SHUTDOWN_DELAY=0s
MC_SHUTDOWN_TIMEOUT=10s
# Optional (default 0 = unlimited): cap on concurrent API requests; extra requests get 503 + Retry-After.
MC_MAX_IN_FLIGHT=0
# Optional: schema-owner URL for `mcapi migrate` (default: MC_DATABASE_URL). Use a separate role in production.
MC_MIGRATE_DATABASE_URL=
# Development only: production runs `mcapi migrate` as a separate step.
MC_MIGRATE_ON_START=false
# Local/dev only (default false): enables the people-directory endpoint used to pick members.
# Production needs an organization boundary first.
MC_LOCAL_PEOPLE_DIRECTORY=false
# Upper bound of one document upload, in bytes (default 26214400 = 25 MiB).
MC_MAX_UPLOAD_BYTES=26214400
# Load shield only, NOT a revocation guarantee. 0s disables the cache.
MC_OIDC_CACHE_TTL=0s

# ---- docker compose only ----
# Host path of the key file, mounted read-only into the containers as /run/secrets/oidc-api-key.json.
MC_OIDC_API_KEY_FILE_HOST=
# Set only to run the PostgreSQL contract tests: `make test-integration` fills it from DB_URL.
# MC_TEST_DATABASE_URL=
