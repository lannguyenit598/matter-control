# Copy to .env and export the variables, or pass them directly when starting the application.
HTTP_ADDR=:8080
# memory | postgres
STORAGE=memory
DATABASE_URL=postgres://userapi:userapi@localhost:5432/userapi?sslmode=disable
# debug | info | warn | error
LOG_LEVEL=info
# Wait after SIGTERM before closing the listener (Kubernetes: 5s-10s)
SHUTDOWN_DELAY=0s
SHUTDOWN_TIMEOUT=10s
REQUEST_TIMEOUT=10s
# Must exceed the load balancer idle timeout (AWS ALB: 60s)
HTTP_IDLE_TIMEOUT=75s
# Comma-separated load balancer / ingress CIDRs. Empty = use the TCP connection IP.
TRUSTED_PROXIES=
READINESS_CHECK_DB=false
# Serve /openapi.json and /docs (public, outside API middleware)
API_DOCS_ENABLED=false

# PostgreSQL pool (always set explicitly in containers)
DB_MAX_CONNS=10
DB_MIN_CONNS=0
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_STATEMENT_TIMEOUT=5s
# Run migrations at startup (development). Production: run `userapi migrate` separately.
MIGRATE_ON_START=false

# Publish events through a transactional outbox (docs/events.md). none | kafka; kafka requires STORAGE=postgres.
# The API and `userapi relay` use the same configuration.
EVENTS_SINK=none
KAFKA_BROKERS=
KAFKA_TOPIC=users
OUTBOX_POLL_INTERVAL=1s
OUTBOX_BATCH_SIZE=100
OUTBOX_RETENTION=168h
# Authenticated Kafka (MSK, Confluent Cloud...): enable TLS and SASL. PLAIN requires TLS.
KAFKA_TLS=false
KAFKA_TLS_CA_FILE=
# PLAIN | SCRAM-SHA-256 | SCRAM-SHA-512; empty = no authentication
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# Liveness probe for `userapi relay` (GET /healthz)
RELAY_HEALTH_ADDR=:8081

# OpenTelemetry (standard OTel SDK variables). Empty endpoint = no export.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=userapi
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.1

# ---- MatterControl product API (`mcapi`, separate from the native userapi above) ----
# PRODUCT database only; never a native userapi database (their `users` schemas differ).
MC_DATABASE_URL=
MC_HTTP_ADDR=127.0.0.1:8081
MC_LOG_LEVEL=info
MC_REQUEST_TIMEOUT=10s
MC_SHUTDOWN_DELAY=0s
MC_SHUTDOWN_TIMEOUT=10s
# Development only: production runs `mcapi migrate` as a separate step.
MC_MIGRATE_ON_START=false
# Private directory for document bytes (created 0700). Local/PoC adapter: not a production object store.
MC_OBJECT_DIR=
# Upper bound of one document upload, in bytes (default 26214400 = 25 MiB).
MC_MAX_UPLOAD_BYTES=26214400
# One canonical issuer, pinned. Introspection is authenticated with the API application's key.
MC_OIDC_ISSUER=
MC_OIDC_INTROSPECTION_URL=
MC_OIDC_AUDIENCE=
MC_OIDC_API_KEY_FILE=
# Load shield only, NOT a revocation guarantee. 0s disables the cache.
MC_OIDC_CACHE_TTL=0s
