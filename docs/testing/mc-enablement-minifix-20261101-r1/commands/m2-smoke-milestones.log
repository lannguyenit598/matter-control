# Example — create a workspace as wt-alice (OWNER persona). The Idempotency-Key is a fresh
# UUIDv7 (macOS uuidgen emits v4, which the API contract rejects).
curl -sS -X POST "http://127.0.0.1:18083/api/v1/workspaces" \
  -H "Authorization: Bearer tok-wt-alice" \
  -H "Content-Type: application/json" \
  -H "Idempotency-Key: 01a19304-5c42-7ba1-9af5-ef721afda8ac" \
  -d '{"name":"Walkthrough WS"}'
