+/** Unexpected receipts make the whole response ambiguous; missing/duplicate receipts keep that row unknown. */
+export function reconcileOutcomes(results: RowOutcome[], rowKeys: string[]): RowOutcome[] {
+  const submitted = new Set(rowKeys)
+  if (submitted.size !== rowKeys.length || results.some((row) => !submitted.has(row.rowKey))) {
+    return rowKeys.map((rowKey) => ({ rowKey, status: 'UNKNOWN' }))
+  }
+  return rowKeys.map((rowKey) => {
+    const matches = results.filter((row) => row.rowKey === rowKey)
+    return matches.length === 1 ? matches[0]! : { rowKey, status: 'UNKNOWN' }
+  })
+}
