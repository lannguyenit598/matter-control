    "MC_R2_SECRET_ACCESS_KEY"
   ],
   "service_has_MC_MIGRATE_DATABASE_URL": false
  },
  "cloud_init": {
   "starts_with_comment": true,
   "cache_ttl_line": [
    "MC_OIDC_CACHE_TTL=15s"
   ],
   "secret_file_paths": [
    "- path: /etc/mattercontrol/mcapi.env",
    "- path: /etc/mattercontrol/fetch-secrets.sh",
