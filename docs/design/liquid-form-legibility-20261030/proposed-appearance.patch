+
+/* Dense readable content inside the refracting rim; controls use a quiet inset material. */
+[data-slot='dialog-panel'] {
+  --muted-foreground: var(--dialog-muted);
+  color: var(--foreground);
+}
+
+[data-slot='dialog-panel']
+  :is([data-slot='input'], [data-slot='textarea'], [data-slot='select-trigger']) {
+  background: var(--field-face);
+  border-radius: 10px;
+  color: var(--foreground);
+  box-shadow:
+    inset 0 1px 0 var(--glass-field-rim),
+    inset 0 -1px 2px var(--glass-edge);
+}
+
+[data-slot='dialog-panel']
+  :is([data-slot='input'], [data-slot='textarea'], [data-slot='select-trigger']):not(
+    [aria-invalid='true']
+  ) {
+  border-color: var(--input);
+}
+
+[data-slot='dialog-panel']
+  :is([data-slot='input'], [data-slot='textarea'], [data-slot='select-trigger']):where(
+    :not(:disabled)
+  ):hover {
+  background: var(--field-hover);
+}
+
+[data-slot='dialog-panel'] :is([data-slot='input'], [data-slot='textarea'])::placeholder {
+  color: var(--muted-foreground);
+  opacity: 1;
+}
+
+[data-slot='dialog-panel']
+  :is([data-slot='input'], [data-slot='textarea'], [data-slot='select-trigger']):disabled {
+  color: var(--disabled);
+  background: var(--muted);
+  box-shadow: none;
+}
+
+@media (prefers-reduced-transparency: reduce), (forced-colors: active) {
+  [data-slot='dialog-panel']
+    :is([data-slot='input'], [data-slot='textarea'], [data-slot='select-trigger']) {
+    background: var(--card);
+    box-shadow: none;
+  }
+}
+
+/* Keep the edge light; broad moving highlights would wash over the form description. */
+[data-slot='dialog-panel'] > .glass-surface > .glass-specular::after {
+  content: none;
+}
